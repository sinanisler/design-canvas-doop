{
  "name": "doop",
  "version": "0.9.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "concurrently -n server,web -c yellow,cyan \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "lint": "oxlint --type-aware --deny-warnings . && eslint . --max-warnings 0",
    "lint:fix": "oxlint --type-aware --deny-warnings --fix . && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doc-lint": "node scripts/doc-lint.mjs",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "oxlint --type-aware --deny-warnings",
      "eslint --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,md,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@electric-sql/pglite": "^0.5.11",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "better-auth": "1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "envalid": "9.0.0",
    "express": "^5.3.0",
    "iconoir-react": "^7.12.1",
    "jose": "6.2.13",
    "nanoid": "^6.0.2",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "posthog-js": "^1.438.21",
    "puppeteer-core": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "stripe": "23.0.1",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "undici": "^8.12.3",
    "ws": "^8.22.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "body-parser": "^2.4.0",
    "brace-expansion": "^5.0.12",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "fast-uri": "^3.1.7",
    "hono": "^4.13.13",
    "ip-address": "^10.7.4",
    "qs": "^6.16.1",
    "source-map-js": "^1.2.2",
    "undici": "^8.12.3"
  }
}
